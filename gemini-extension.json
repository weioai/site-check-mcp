{
  "name": "weio-site-check",
  "version": "1.3.0",
  "description": "Website facts for agents: HTTPS/certificate checks, public site info, small local-business search",
  "mcpServers": {
    "weio-site-check": {
      "httpUrl": "https://weio.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${WEIO_API_KEY:-}"
      }
    }
  },
  "contextFileName": "GEMINI.md",
  "settings": [
    {
      "name": "Weio API key (optional)",
      "description": "wk_... key",
      "envVar": "WEIO_API_KEY",
      "sensitive": true
    }
  ]
}
