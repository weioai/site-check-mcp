{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.weio/site-check",
  "title": "Weio site check",
  "description": "Website facts for agents: HTTPS/certificate checks, public site info, small local-business search.",
  "version": "1.2.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://weio.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. 'Bearer wk_...' API key",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/weioai/site-check-mcp",
    "source": "github"
  }
}
